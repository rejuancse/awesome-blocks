{
    "apiVersion": 2,
    "name": "awesome/grid-block",
    "title": "Grid Block",
    "category": "awesome-block",
    "icon": "grid-view",
    "description": "Create responsive grid layouts with customizable columns and gaps",
    "keywords": ["grid", "layout", "columns", "rows"],
    "attributes": {
        "columns": {
            "type": "number",
            "default": 3
        },
        "columnsTablet": {
            "type": "number",
            "default": 2
        },
        "columnsMobile": {
            "type": "number",
            "default": 1
        },
        "rowGap": {
            "type": "number",
            "default": 20
        },
        "columnGap": {
            "type": "number",
            "default": 20
        },
        "align": {
            "type": "string",
            "default": "left"
        },
        "verticalAlign": {
            "type": "string",
            "default": "top"
        },
        "gridAutoFlow": {
            "type": "string",
            "default": "row"
        }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false,
        "multiple": true
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css"
}
